    {
      "name": "05 - Rate Limiting & Burst Protection",
      "description": "Tests Redis sliding window rate limiter using an isolated test source (rate-limited-source, limit=2 req/min). Dispatches 3 rapid requests; the 3rd request is blocked with HTTP 429 Too Many Requests and RFC-compliant Retry-After header. Does NOT interfere with production sources.",
      "item": [
        {
          "name": "Burst Request 1 - Allowed (202 Accepted)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking_id\": \"trc-rl-1\",\n  \"event_type\": \"incident.triggered\",\n  \"payload\": {\n    \"burst\": 1\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/{{rateLimitSourceSlug}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "{{rateLimitSourceSlug}}",
                ""
              ]
            },
            "description": "First burst request under limit (1 of 2 allowed). Expects 202 Accepted."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var CryptoJS = require('crypto-js');",
                  "var nonce = Date.now();",
                  "var bodyObj = {",
                  "    'tracking_id': 'trc-rl-1-' + nonce,",
