    {
      "name": "02 - Ingestion Gateway (Core)",
      "description": "Primary high-throughput asynchronous webhook ingestion perimeter. Verifies HMAC authentication, envelope validation, database persistence, Celery dispatch, and sub-100ms HTTP 202 Accepted ACK.",
      "item": [
        {
          "name": "Ingest Fresh Webhook (202 Accepted ACK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking_id\": \"trc-placeholder\",\n  \"event_type\": \"incident.triggered\",\n  \"payload\": {\n    \"id\": \"PD-INC-101\",\n    \"title\": \"Postman Ingestion Verification\",\n    \"urgency\": \"high\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/{{sourceSlug}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "{{sourceSlug}}",
                ""
              ]
            },
            "description": "Dispatches a valid webhook event signed with HMAC-SHA256. Expects an immediate HTTP 202 Accepted ACK in < 100ms with tracking metadata."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var CryptoJS = require('crypto-js');",
                  "// 1. Generate unique timestamp nonce and tracking ID",
                  "var nonce = Date.now();",
                  "var trackingId = 'trc-pm-' + nonce;",
                  "pm.environment.set('trackingId', trackingId);",
                  "",
                  "// 2. Build fresh request payload",
                  "var payloadObj = {",
                  "    'tracking_id': trackingId,",
                  "    'event_type': 'incident.triggered',",
                  "    'payload': {",
                  "        'id': 'PD-INC-' + nonce,",
                  "        'title': 'Postman Automated Ingestion Verification',",
                  "        'service': 'database-cluster',",
                  "        'urgency': 'high',",
                  "        'created_at': new Date().toISOString()",
                  "    }",
                  "};",
                  "var rawBody = JSON.stringify(payloadObj);",
                  "pm.request.body.raw = rawBody;",
                  "",
                  "// 3. Cache exact raw body for subsequent idempotency deduplication test",
                  "pm.environment.set('lastDispatchedRawBody', rawBody);",
                  "",
                  "// 4. Compute cryptographic HMAC-SHA256 signature",
                  "var secret = pm.environment.get('webhookSecret');",
                  "if (!secret || typeof secret !== 'string' || secret.trim() === '' || secret.startsWith('<') || secret.includes('YOUR_WEBHOOK_HMAC_SECRET')) {",
                  "    throw new Error(\"Configuration Error: 'webhookSecret' is missing, empty, or unconfigured in the active Postman environment. Set a valid secret before running.\");",
                  "}",
                  "var hash = CryptoJS.HmacSHA256(rawBody, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Signature-256', value: 'sha256=' + hash });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202 Accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test('Response latency complies with sub-100ms ACK target', function () {",
                  "    // Gateway immediately delegates to Celery worker without blocking",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('Response body contains complete tracking acknowledgment', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('accepted');",
                  "    pm.expect(jsonData.source).to.eql(pm.environment.get('sourceSlug'));",
                  "    pm.expect(jsonData.tracking_id).to.eql(pm.environment.get('trackingId'));",
                  "    pm.expect(jsonData.idempotency_hash).to.be.a('string').and.have.lengthOf(64);",
                  "    pm.expect(jsonData.received_at).to.be.a('string');",
                  "    pm.expect(jsonData.message).to.eql('Webhook queued for processing');",
                  "    ",
                  "    // Persist idempotency hash for duplicate replay test",
                  "    pm.environment.set('lastIdempotencyHash', jsonData.idempotency_hash);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Deduplication & Idempotency Engine",
      "description": "Tests O(1) Redis SET NX idempotency filter. Must be executed immediately after Request 02 within the 60-second Redis TTL window.",
      "item": [
        {
          "name": "Duplicate Webhook Replay (200 OK Duplicate Ignored)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Replaced dynamically by pre-request script\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/{{sourceSlug}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "{{sourceSlug}}",
                ""
              ]
            },
            "description": "Replays the exact raw byte payload from the previous request within 60s. Expects immediate HTTP 200 OK with 'duplicate_ignored' without database re-write or Celery re-enqueue."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var CryptoJS = require('crypto-js');",
                  "// 1. Fetch cached raw body from previous request",
                  "var rawBody = pm.environment.get('lastDispatchedRawBody');",
                  "if (!rawBody) {",
                  "    // Fallback if run standalone",
                  "    rawBody = JSON.stringify({",
                  "        'tracking_id': 'trc-standalone-dup',",
                  "        'event_type': 'incident.duplicate',",
                  "        'payload': { 'id': 'FALLBACK-DUP-001' }",
                  "    });",
                  "}",
                  "pm.request.body.raw = rawBody;",
                  "",
                  "// 2. Re-compute matching HMAC signature",
                  "var secret = pm.environment.get('webhookSecret');",
                  "if (!secret || typeof secret !== 'string' || secret.trim() === '' || secret.startsWith('<') || secret.includes('YOUR_WEBHOOK_HMAC_SECRET')) {",
                  "    throw new Error(\"Configuration Error: 'webhookSecret' is missing, empty, or unconfigured in the active Postman environment. Set a valid secret before running.\");",
                  "}",
                  "var hash = CryptoJS.HmacSHA256(rawBody, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Signature-256', value: 'sha256=' + hash });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK (Duplicate Ignored)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response confirms idempotent deduplication without re-queueing', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('duplicate_ignored');",
                  "    pm.expect(jsonData.source).to.eql(pm.environment.get('sourceSlug'));",
                  "    pm.expect(jsonData.tracking_id).to.eql(pm.environment.get('trackingId'));",
                  "    var expectedHash = pm.environment.get('lastIdempotencyHash');",
                  "    if (expectedHash) {",
                  "        pm.expect(jsonData.idempotency_hash).to.eql(expectedHash);",
                  "    }",
                  "    pm.expect(jsonData.message).to.include('Idempotent duplicate detected within 60s TTL window');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
