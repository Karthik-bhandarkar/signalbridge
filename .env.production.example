# =============================================================================
# SignalBridge — Production AWS Environment Configuration Template
# =============================================================================
# Copy this template to .env.production on your deployment server / EC2 instance.
# NEVER commit the real populated .env.production to GitHub.

# -----------------------------------------------------------------------------
# 1. DJANGO CORE CONFIGURATION
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-min-50-chars
# Comma-separated list of allowed hostnames (e.g. ALB DNS, EC2 Public IP, custom domain)
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,your-alb-dns-name.us-east-1.elb.amazonaws.com,localhost,127.0.0.1,web,nginx
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_LOG_LEVEL=INFO

# Comma-separated trusted origins for CSRF & CORS
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,http://your-alb-dns-name.us-east-1.elb.amazonaws.com
CORS_ALLOWED_ORIGINS=https://api.yourdomain.com,http://your-alb-dns-name.us-east-1.elb.amazonaws.com

# -----------------------------------------------------------------------------
# 2. AMAZON RDS POSTGRESQL CONFIGURATION
# -----------------------------------------------------------------------------
POSTGRES_DB=signalbridge_db
POSTGRES_USER=signalbridge_admin
POSTGRES_PASSWORD=replace-with-your-strong-rds-password
POSTGRES_HOST=signalbridge-postgres.xxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# -----------------------------------------------------------------------------
# 3. AMAZON ELASTICACHE REDIS CONFIGURATION
# -----------------------------------------------------------------------------
# DB 0 = Shared Sliding-Window Rate Limiter & Idempotency Cache
REDIS_URL=redis://signalbridge-redis.xxxxxx.0001.use1.cache.amazonaws.com:6379/0
# DB 1 = Celery Task Message Broker
CELERY_BROKER_URL=redis://signalbridge-redis.xxxxxx.0001.use1.cache.amazonaws.com:6379/1
# DB 2 = Celery Task Result Storage
CELERY_RESULT_BACKEND=redis://signalbridge-redis.xxxxxx.0001.use1.cache.amazonaws.com:6379/2

# -----------------------------------------------------------------------------
# 4. AMAZON S3 COLD STORAGE ARCHIVAL
# -----------------------------------------------------------------------------
AWS_STORAGE_BUCKET_NAME=signalbridge-production-archives-your-unique-suffix
AWS_DEFAULT_REGION=us-east-1
AWS_S3_REGION_NAME=us-east-1
# Leave blank when running on EC2 with IAM Instance Profile attached:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# 5. GUNICORN & CELERY SCALING
# -----------------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
CELERY_CONCURRENCY=4
PROD_HTTP_PORT=80
