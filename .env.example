# -----------------------------------------------------------------------------
# SignalBridge Environment Variables Configuration Template
# Copy this file to .env before starting containers: `cp .env.example .env`
# -----------------------------------------------------------------------------

# Django Settings
DJANGO_SECRET_KEY=django-insecure-development-key-change-in-production-123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.local

# PostgreSQL 16 Configuration
POSTGRES_DB=signalbridge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis 7 & Celery Broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3 Mock Object Storage Configuration
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_STORAGE_BUCKET_NAME=signalbridge-raw-archives
AWS_S3_ENDPOINT_URL=http://s3:9090
AWS_S3_REGION_NAME=us-east-1

# Webhook Security
WEBHOOK_SIGNING_SECRET=development_signing_secret_do_not_use_in_prod
