# =============================================================================
# SignalBridge — Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env before starting containers: `cp .env.example .env`
# In production, inject these secrets via OCI Vault, HashiCorp Vault, or environment secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------
# REQUIRED in production: Generate with `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=django-insecure-development-key-change-in-production-123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0
# Set to 'config.settings.production' in staging and production:
DJANGO_SETTINGS_MODULE=config.settings.local

# Production TLS / Security Headers (ignored when DJANGO_SETTINGS_MODULE=config.settings.local):
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 2. POSTGRESQL 16 DATABASE
# -----------------------------------------------------------------------------
POSTGRES_DB=signalbridge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DJANGO_DB_CONN_MAX_AGE=600

# -----------------------------------------------------------------------------
# 3. REDIS 7 & CELERY MESSAGE BROKER
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=4

# -----------------------------------------------------------------------------
# 4. GUNICORN WSGI APPLICATION SERVER
# -----------------------------------------------------------------------------
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# -----------------------------------------------------------------------------
# 5. COLD OBJECT STORAGE ARCHIVAL (OCI Object Storage S3-Compat / Adobe S3Mock)
# -----------------------------------------------------------------------------
# In OCI: Set AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY to your OCI Customer Secret Key.
# Set AWS_S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_STORAGE_BUCKET_NAME=signalbridge-raw-archives
AWS_S3_ENDPOINT_URL=http://s3:9090
AWS_S3_REGION_NAME=us-east-1

# -----------------------------------------------------------------------------
# 6. WEBHOOK GATEWAY SECURITY
# -----------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=development_signing_secret_do_not_use_in_prod
